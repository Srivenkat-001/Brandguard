# Copy this file to ".env" (same folder as app.py) and fill in your keys.
# Several keys per platform: separate with commas. When one runs out of quota the next is used.
# Leave a line empty or delete it if you don't have that key.

# YouTube Data API v3 keys (free)
YOUTUBE_API_KEYS=

# X (Twitter) bearer tokens (paid per request)
X_BEARER_TOKENS=

# Instagram Graph API: one INSTAGRAM_USER_ID:ACCESS_TOKEN pair per team member
IG_ACCOUNTS=

# On Streamlit Community Cloud there is no .env file: paste the same lines into
# App settings > Secrets, in this format:
#   YOUTUBE_API_KEYS = "key1,key2,key3"
#   IG_ACCOUNTS = "1784123:EAAB...,1785456:EAAC..."
